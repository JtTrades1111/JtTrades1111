# Copy this file to ".env" (also git-ignored) and paste your SimpleFIN
# setup token below. On the first run, `npm run sync` will exchange the
# setup token for a permanent access URL and rewrite this file with:
#   SIMPLEFIN_ACCESS_URL=https://...:...@bridge.simplefin.org/simplefin
# All values stay on your Mac — nothing is uploaded anywhere except
# the outbound HTTPS call to bridge.simplefin.org.

SIMPLEFIN_SETUP_TOKEN=
